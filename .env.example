# Every var thump's beats read from the environment. No secrets — every
# value below is either a placeholder or a real default. Copy to `.env`,
# fill in what your beat needs, and source it (or let Tilt/your process
# manager do it) before `task run:<beat>`.
#
# Which vars are required depends on two things: which beat you're running,
# and whether NATS_URL is set. NATS_URL present selects broker mode (reads
# from NATS, ships its WAL to S3); absent selects offline dir-poll mode
# (reads/writes plain directories, no WAL). See internal/config/config.go —
# LoadClank/LoadHiss/LoadRattle/LoadThump — for the authoritative
# required/optional split per beat.

## --- Shared across every beat ---

# Selects broker mode when set; offline dir-poll mode when unset.
NATS_URL=nats://localhost:4222

# Optional. Unset means no /metrics, /healthz, or /readyz server at all —
# a valid production state, not a misconfiguration.
METRICS_ADDR=:9090

# Optional. Unset disables tracing entirely.
OTEL_EXPORTER_OTLP_ENDPOINT=

## --- WAL / S3 offload — required only in broker mode, all four beats ---

WAL_DIR=/var/lib/thump/wal
S3_ENDPOINT=http://localhost:9000
S3_BUCKET=thump-wal
S3_ACCESS_KEY=dummy-access-key
S3_SECRET_KEY=dummy-secret-key

## --- rattle (Detect) ---

# Required unconditionally — rattle is the first hop, nothing upstream of it.
PROM_URL=http://localhost:9090

# Optional pair — leave both empty to skip whir dependency-state checks.
WHIR_CATALOG=config/whir/catalog.yaml
WHIR_STATE_QUERIES=config/whir/state-queries.yaml

# Optional — empty disables the Hubble traffic source.
RATTLE_TRAFFIC=

# Required unconditionally.
RATTLE_WATCH=/var/lib/thump/rattle/watch.yaml

# Optional even offline — unset means detections are logged, not published.
RATTLE_OUTBOX=/var/lib/thump/rattle/outbox

## --- clank (Reason) ---

ANTHROPIC_API_KEY=dummy-api-key

# Required — the authored action catalog and failure-class definitions. This
# points at the thump-test profile's copy for this offline loop; a Tilt/Helm
# deployment binds a profile's own config/<profile>/actions/ instead
# (configmap-actions.yaml).
ACTION_CATALOG=config/thump-test/actions/catalog.yaml
FAILURE_CLASSES=config/thump-test/actions/failure-classes.yaml

# Optional — how far back Engine.Propose looks for a live set on the same
# fingerprint before suppressing a redelivery. Defaults to 1h.
DEDUPE_WINDOW=1h

# Optional — empty disables the metrics tool; EVIDENCE_QUERIES only matters
# alongside a set PROM_URL.
EVIDENCE_QUERIES=config/clank/evidence-queries.yaml

# Optional — empty disables the loki tool.
LOKI_URL=http://localhost:3100

# Optional, offline path only — broker mode always persists transcripts to
# S3 via the WAL_DIR/S3_* vars above, ignoring this.
CLANK_TRANSCRIPTS=/var/lib/thump/clank/transcripts

# Required only in the offline (non-broker) path.
CLANK_INBOX=/var/lib/thump/clank/inbox
CLANK_OUTBOX=/var/lib/thump/clank/outbox
CLANK_OUTCOMES=/var/lib/thump/clank/outcomes
CLANK_DECLINES=/var/lib/thump/clank/declines

## --- hiss (Govern) ---

# Base copy for this offline loop; a deployment binds config/<profile>/hiss/ instead.
HISS_POLICY=config/hiss/policy.yaml

# Required only in the offline (non-broker) path.
HISS_INBOX=/var/lib/thump/hiss/inbox
HISS_OUTBOX=/var/lib/thump/hiss/outbox

## --- thump (Act) ---

# "dry" (default) or "live". Live additionally requires an armed kill switch.
THUMP_EXECUTOR=dry

# Only read in live mode.
THUMP_KILLSWITCH=/var/lib/thump/thump/killswitch.yaml

# Optional — empty disables the automatic reversal watcher.
SLACK_WEBHOOK_URL=

# Required only in the offline (non-broker) path.
THUMP_INBOX=/var/lib/thump/thump/inbox
THUMP_OUTBOX=/var/lib/thump/thump/outbox
